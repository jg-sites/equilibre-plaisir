{
  "name": "voidfactory-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "eslint . --fix && prettier --write \"**/*.{js,jsx,mjs,ts,tsx,md,mdx,json,css,scss,html}\"",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "release": "semantic-release",
    "prepare": "husky"
  },
  "dependencies": {
